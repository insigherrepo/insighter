# ============================================================================
# INSIGHTER — Template de Conexão (.env.example)
# A chave da API do Google Gemini fica salva exclusivamente na tabela
# public.app_secrets do banco de dados Supabase.
# ============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
APP_PORT=5173
NODE_ENV=development

# Repositório do GitHub para Auto-Update (ex: usuario/insighter-releases)
VITE_GITHUB_UPDATE_REPO=
GITHUB_UPDATE_REPO=
GITHUB_TOKEN=
